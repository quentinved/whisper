[Unit]
Description=Whisper - Secure Secret Sharing
After=network.target postgresql-17.service
Wants=postgresql-17.service

[Service]
Type=simple
User=whisper
Group=whisper
WorkingDirectory=/opt/whisper
ExecStart=/opt/whisper/whisper-server
EnvironmentFile=/opt/whisper/.env
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
